# Copy to .env and adjust for your environment.
# When running via docker compose, the backend service overrides these.

# Postgres connection string used by both the app and the knex CLI.
DATABASE_URL=postgres://meowpay:meowpay@localhost:5432/meowpay

# Port the HTTP server listens on.
PORT=3000

# development | test | production
NODE_ENV=development

# Secret used to sign/verify auth JWTs. Any long random string in dev;
# use a securely generated, unshared value in production.
JWT_SECRET=dev-only-change-me

# How long an issued JWT stays valid, in seconds. Default below is 7 days.
JWT_EXPIRES_IN_SECONDS=604800
